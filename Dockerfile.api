FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY scripts/requirements.txt scripts/requirements.txt
COPY services/api/requirements.txt services/api/requirements.txt
RUN pip install --no-cache-dir -r services/api/requirements.txt && useradd --create-home app
COPY --chown=app:app services services
COPY --chown=app:app scripts scripts
COPY --chown=app:app packages packages
COPY --chown=app:app public/data public/data
RUN mkdir -p .data-cache && chown app:app .data-cache
USER app
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "services.api.app.main:app", "--host", "0.0.0.0", "--port", "8000"]

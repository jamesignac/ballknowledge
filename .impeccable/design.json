  "narrative": {
    "northStar": "Scouting desk",
    "overview": "Warm paper, pale olive navigation, forest ink, and court-orange actions give a dense analysis workspace a familiar basketball character. Player photographs and oversize jersey numerals provide recognition; aligned tables and compact conventional controls support sustained exploration.\n\nThis records the implemented local MVP. The visual direction was selected during code-led implementation; no visual comp or aesthetic workshop was approved by the user.",
    "keyCharacteristics": [
      "Warm, flat analytical surfaces.",
      "Portrait-led player identity.",
      "Compact controls and aligned numeric columns.",
      "One visible scope across linked representations."
    ],
    "rules": [
      {
        "name": "The Scope Rule",
        "body": "Preserve the same selection language across tables, plots, profiles, and comparisons: orange marks interaction and comparison state; team colors identify teams.",
        "section": "colors"
      },
      {
        "name": "The Numeric Alignment Rule",
        "body": "Keep statistics aligned and use tabular numerals in tables and spotlight stat groups.",
        "section": "typography"
      },
      {
        "name": "The Surface Rule",
        "body": "Use borders and tone for ordinary panels; reserve elevation for overlays, tooltips, the comparison dock, and feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve clear player identity through headshots, names, and jersey context.",
      "Do keep source provenance, observed coverage, freshness, and sample size visible near statistics.",
      "Do preserve linked selection states and numeric alignment across representations.",
      "Do keep phone charts readable and confine horizontal scrolling to data tables.",
      "Do retain visible keyboard focus, native dialog behavior, and reduced-motion support."
    ],
    "donts": [
      "Don't apply overlay shadows to ordinary data panels.",
      "Don't use team colors as replacements for the orange interaction state.",
      "Don't shrink the desktop scatter wholesale to produce the phone chart."
    ]
  }
}
